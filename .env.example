# Forge Gallery — konfiguracja środowiska
# Skopiuj do .env i uzupełnij wartości

# Nazwa użytkownika do logowania
FG_USERNAME=admin

# Hash SHA-256 hasła. Wygeneruj poleceniem:
# python3 -c "import hashlib; print(hashlib.sha256(b'twoje-haslo').hexdigest())"
FG_PASSWORD_HASH=

# Ścieżka do katalogu z outputami Stable Diffusion / Forge
FG_OUTPUTS_DIR=/home/user/forge/outputs

# Port HTTP serwera (domyślnie 7861)
FG_PORT=7861
